# Hugging Face fine-grained token (write access to the Space and bucket).
# In CI this comes from the HF_TOKEN GitHub secret instead.
HF_TOKEN=
HF_SPACE=katospiegel/colectivo-pepita
# Only used by `just assets` (local dev download).
HF_BUCKET=katospiegel/colectivo-pepita

# Local dev only: password for the gate when running `just dev`.
APP_PASSWORD=dev
